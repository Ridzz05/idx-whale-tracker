LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=
DB_PATH=data/whale.db

# OMP Browser Relay. The app reads idx.co.id through your own Chrome session.
RELAY_URL=http://127.0.0.1:9224
# How many tickers the live poller follows (largest traded value first).
IDX_WATCHLIST_SIZE=30
# Gap between two IDX requests. IDX answers 429/403 when requests come faster.
IDX_REQUEST_GAP_MS=1500

# Only used as a fallback when the relay is unavailable.
CHROME_PATH=
